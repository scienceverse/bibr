# bibr .env — minimal settings to get started.
# Copy to .env and edit, or run `bibr config example --full` to see every setting.
# See https://bibr.org/reference/settings/ for the complete reference.

# LLM provider: "google" (default), "openai", "anthropic", "groq", or "ollama".
# LLM_PROVIDER=google

# Model for that provider. The default is a Gemini model, so set this whenever
# LLM_PROVIDER is not "google" (for example claude-haiku-5-5 with "anthropic").
# LLM_MODEL=gemini-3.5-flash-lite

# Google AI API key, for LLM_PROVIDER=google. Legacy aliases GEMINI_API_KEY and LANGEXTRACT_API_KEY also accepted.
# GOOGLE_API_KEY=

# Contact email for the Crossref polite API pool (strongly recommended).
# CROSSREF_API_EMAIL=

# Optional bibr-resolver candidate-search service (OpenAlex + Crossref/DataCite).
# Not publicly released yet: leave BIBR_RESOLVER_URL unset unless you run one.
# When set and Crossref enrichment is on (CROSSREF_ENRICH=true or --crossref), it is
# tried BEFORE Crossref; unset = disabled (bare Crossref). Point it at a host the
# deployment can actually reach — a private LAN name will NOT resolve from a remote
# worker; use a routable host/IP or service DNS name. If the URL is set but
# unreachable, bibr logs a WARNING and degrades to Crossref.
# BIBR_RESOLVER_URL=http://resolver-host:2010
# BIBR_RESOLVER_ENRICH=true           # master gate; false skips the resolver even if URL is set
# BIBR_RESOLVER_AUTHORITATIVE=false   # true = a clean resolver miss is final (skips redundant Crossref)
# BIBR_RESOLVER_TIMEOUT=30.0
# BIBR_RESOLVER_RETRIES=3             # retries after a busy answer (503 etc.) or a timeout
# BIBR_RESOLVER_MAX_CONCURRENCY=8     # requests in flight across all papers in this process
# BIBR_RESOLVER_LIMIT=20

# OCR backend: "paddle" (default automatic selector), "paddle-vllm" (GPU),
# "paddle-rapid-mlx" (Apple Silicon), "glm-llama" (llama.cpp), or a cloud vision LLM:
# "gemini", "openai", "anthropic". Full list:
# https://bibr.org/reference/settings/
# OCR_BACKEND=paddle

# Model for the cloud vision OCR backends. The default is a Gemini model, so set
# it with OCR_BACKEND "openai" or "anthropic" (for example claude-haiku-5-5).
# OCR_VISION_MODEL=gemini-3-flash-preview

# bibr serve logging: level for bibr's own loggers (debug|info|warning|error), and
# an optional JSONL file for per-request / per-extraction metering records
# (stderr when unset).
# SERVE_LOG_LEVEL=info
# METER_LOG_PATH=

# Required by the Docker Compose `serve` profile, which runs fail-closed in
# production mode. Generate strong values rather than reusing these comments.
# REDIS_PASSWORD=
# AUTH_API_KEY=  # at least 32 characters; e.g. `openssl rand -hex 32`
