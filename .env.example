# bibr .env — the settings most people touch.
# Everything is commented out: with nothing set, bibr runs in fast mode
# (local models only, no LLM and no API key). Uncomment what you need,
# or let `bibr setup` write this file for you.
# `bibr config example --full` lists every setting.

# Run mode: "fast" makes no LLM call (the front-matter tagger reads the title, authors
# and abstract), "full" uses the configured LLM, and "auto" (default) runs fast when no
# LLM is configured and full when one is. The --fast and --full flags override it for
# one run.
# PIPELINE_MODE=auto

# LLM provider: "google" (default), "openai", "anthropic", "groq", or "ollama". Custom
# adapters added through bibr.clients.providers.register cannot be named here; set them
# on the settings object in code instead.
# LLM_PROVIDER=google

# Google AI API key, for LLM_PROVIDER=google. Legacy aliases GEMINI_API_KEY and
# LANGEXTRACT_API_KEY also accepted.
# GOOGLE_API_KEY=

# Anthropic API key, for LLM_PROVIDER=anthropic. Alias CLAUDE_API_KEY also accepted.
# ANTHROPIC_API_KEY=

# Generic API key, used by the openai provider and OpenAI-compatible endpoints.
# Google/Anthropic/Groq use their provider-specific keys.
# LLM_API_KEY=

# OCR server backend: "paddle" (default), "paddle-vllm" (GPU/vLLM), "paddle-rapid-mlx"
# (Apple Silicon/Rapid-MLX), "paddle-mlx-vlm" (Apple Silicon/MLX-VLM), or "paddle-http"
# (external Paddle server); "glm-mlx" (disabled — use glm-rapid-mlx), "glm-rapid-mlx"
# (Apple Silicon/Rapid-MLX), "glm-llama" (Windows default; llama.cpp), or "glm-http"
# (external GLM server) — plus the cloud vision-LLM providers "gemini", "openai", and
# "anthropic", and "text-layer", which runs no OCR model and reads born-digital PDFs
# from their embedded text layer (a scanned PDF is refused: it needs a real OCR route).
# A fast run (no LLM call) with none of OCR_BACKEND, OCR_MODEL or OCR_PROFILE set, and
# no --ocr or --ocr-url, uses the text-layer backend, whatever GPU the machine has. A
# fast bibr serve does the same when OCR_BASE_URL is not set either.
# OCR_BACKEND=paddle

# Contact email for the Crossref polite API pool (strongly recommended).
# CROSSREF_API_EMAIL=

# ============================================================================
# bibr serve and shared deployments. Not needed for `bibr chew` on your own
# machine; see https://bibr.org/guides/deployment/ before setting these.
# ============================================================================

# Optional bibr-resolver candidate-search service (OpenAlex + Crossref/DataCite).
# Not publicly released yet: leave BIBR_RESOLVER_URL unset unless you run one.
# When set and Crossref enrichment is on (CROSSREF_ENRICH=true or --crossref), it is
# tried BEFORE Crossref; unset = disabled (bare Crossref). Point it at a host the
# deployment can actually reach — a private LAN name will NOT resolve from a remote
# worker; use a routable host/IP or service DNS name. If the URL is set but
# unreachable, bibr logs a WARNING and degrades to Crossref.
# BIBR_RESOLVER_URL=http://resolver-host:2010
# BIBR_RESOLVER_ENRICH=true           # master gate; false skips the resolver even if URL is set
# BIBR_RESOLVER_AUTHORITATIVE=false   # true = a clean resolver miss is final (skips redundant Crossref)
# BIBR_RESOLVER_TIMEOUT=30.0
# BIBR_RESOLVER_RETRIES=3             # retries after a busy answer (503 etc.) or a timeout
# BIBR_RESOLVER_MAX_CONCURRENCY=8     # requests in flight across all papers in this process
# BIBR_RESOLVER_LIMIT=20

# bibr serve logging: level for bibr's own loggers (debug|info|warning|error), and
# an optional JSONL file for per-request / per-extraction metering records
# (stderr when unset).
# SERVE_LOG_LEVEL=info
# METER_LOG_PATH=

# Required by the Docker Compose `serve` profile, which runs fail-closed in
# production mode. Generate strong values rather than reusing these comments.
# REDIS_PASSWORD=
# AUTH_API_KEY=  # at least 32 characters; e.g. `openssl rand -hex 32`
